$(BUILDDIR)/prosody.o: $(PASSESDIR)/prosody.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) -DNVSP_FRONTEND_EXPORTS=1 -c $< -o $@

$(BUILDDIR)/rate_compensation.o: $(PASSESDIR)/rate_compensation.cpp
	$(CXX) $(CXXFLAGS) $(INCLUDES) -DNVSP_FRONTEND_EXPORTS=1 -c $< -o $@

